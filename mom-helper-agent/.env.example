# The address where this server can be reached from the internet (Twilio calls it).
PUBLIC_URL=https://your-app.example.com
# From console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_NUMBER=+15555550123
# From console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Password for the family dashboard at /dashboard (any username)
DASHBOARD_PASSWORD=choose-a-long-password
CONFIG=config.yaml
ACTIVITY_LOG=data/activity.jsonl
